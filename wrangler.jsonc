{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yazooblu1",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}

{
  "name": "your-worker-or-pages-project",
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<YOUR_HYPERDRIVE_CONFIG_ID>"
    }
  ]
}
